# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789

# Spot account (50 USDT) + ~50% TP3 upside goal
ACCOUNT_BALANCE_USDT=50
TARGET_UPSIDE_PCT=50

# 70% alerts are allowed ONLY when quality filters pass (anti-spam)
MIN_CONFIDENCE=70
QUALITY_FILTERS=true
# Only take 70% signals IF:
#   BTC volatility < X  AND  Volume > 20-period avg  AND  not news time
BTC_MAX_VOLATILITY_PCT=1.20
REQUIRE_VOLUME_ABOVE_AVG=true
MIN_ALIGNED_FACTORS=2

# Faster scanning of liquid spot pairs
SCAN_MODE=fast
MIN_TURNOVER_USDT=300000
SCAN_TOP_N=200
MAX_WORKERS=3
REQUEST_GAP_SECONDS=0.22
SCAN_INTERVAL_SECONDS=300
FETCH_DEALS=false
FETCH_DEPTH=false
SYMBOL_WHITELIST=

# false = no scan-progress spam (type "status" in Telegram anytime)
TELEGRAM_STATUS=false

LOG_LEVEL=INFO
