# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789

# Account balance used for 1% risk position sizing (USDT)
ACCOUNT_BALANCE_USDT=1000

# Minimum confidence to emit a trade signal (0-100)
MIN_CONFIDENCE=85

# Scan interval in seconds (default 5 minutes)
SCAN_INTERVAL_SECONDS=300

# Max concurrent symbol analyses
MAX_WORKERS=8

# Optional: comma-separated symbols to scan (empty = all USDT perpetual contracts)
# SYMBOL_WHITELIST=BTC_USDT,ETH_USDT,SOL_USDT

# Optional news / calendar API keys (fundamentals module degrades gracefully without them)
# NEWSAPI_KEY=
# COINGECKO is public — no key required

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
