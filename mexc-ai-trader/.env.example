# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789

# Spot account (50 USDT)
ACCOUNT_BALANCE_USDT=50

# Cryptobull-style spot breakouts (channel/wedge OR resistance break)
SETUP_MODE=breakout
# Aim TP3 near +50% (your requested upside goal)
TARGET_UPSIDE_PCT=50
PREFER_MOVERS=true
MIN_MOVER_PCT=5
MAX_STOP_PCT=0.18

MIN_CONFIDENCE=65
QUALITY_FILTERS=true
BTC_MAX_VOLATILITY_PCT=2.50
REQUIRE_VOLUME_ABOVE_AVG=true
MIN_ALIGNED_FACTORS=1

SCAN_MODE=fast
MIN_TURNOVER_USDT=100000
SCAN_TOP_N=200
MAX_WORKERS=3
REQUEST_GAP_SECONDS=0.22
SCAN_INTERVAL_SECONDS=300
FETCH_DEALS=false
FETCH_DEPTH=false
SYMBOL_WHITELIST=

TELEGRAM_STATUS=false
LOG_LEVEL=INFO
