# === FUTURES bot .env template (quiet + quality) ===
TELEGRAM_BOT_TOKEN=your_futures_bot_token
TELEGRAM_CHAT_ID=7004857701

ACCOUNT_BALANCE_USDT=100

# 70% alerts ONLY when quality filters pass (anti-chop)
MIN_CONFIDENCE=70
QUALITY_FILTERS=true
# Only take 70% signals IF:
#   BTC volatility < X  AND  Volume > 20-period avg  AND  not news time
BTC_MAX_VOLATILITY_PCT=1.20
REQUIRE_VOLUME_ABOVE_AVG=true
MIN_ALIGNED_FACTORS=2

# Scan best ~200 liquid pairs
SCAN_MODE=fast
MIN_TURNOVER_USDT=300000
SCAN_TOP_N=200
MAX_WORKERS=3
REQUEST_GAP_SECONDS=0.22
SCAN_INTERVAL_SECONDS=300
FETCH_DEALS=false
SYMBOL_WHITELIST=

# No scan spam — type "status" anytime; signals send automatically
TELEGRAM_STATUS=false

LOG_LEVEL=INFO
