# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789

# Spot account you trade with (default 50 USDT — size / TP3 math uses this)
ACCOUNT_BALANCE_USDT=50
# Aim TP3 near this % price upside (50% on alts; majors may not reach it)
TARGET_UPSIDE_PCT=50

# Only alert at institutional threshold
MIN_CONFIDENCE=85

# Faster scanning of liquid spot pairs
SCAN_MODE=fast
MIN_TURNOVER_USDT=300000
SCAN_TOP_N=200
MAX_WORKERS=3
REQUEST_GAP_SECONDS=0.22
SCAN_INTERVAL_SECONDS=300
FETCH_DEALS=false
FETCH_DEPTH=false
SYMBOL_WHITELIST=

# Telegram: false = do NOT auto-spam scan progress.
# You can still type "status" in Telegram anytime for a live update.
TELEGRAM_STATUS=false

QUALITY_FILTERS=true
BTC_MAX_VOLATILITY_PCT=1.20
REQUIRE_VOLUME_ABOVE_AVG=true
MIN_ALIGNED_FACTORS=2

LOG_LEVEL=INFO
