# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789

ACCOUNT_BALANCE_USDT=50

SETUP_MODE=breakout
BREAKOUT_AGGRESSIVE=true
BREAKOUT_MIN_SCORE=55

# Confidence 80%+ for instant alerts
MIN_CONFIDENCE=80
# Always send 3 STRONG BUY signals per UTC day
DAILY_SIGNAL_TARGET=3
FORCE_STRONG_BUY=true

# Profit ladder
TP1_PCT=50
TP2_PCT=200
TP3_PCT=800

PREFER_MOVERS=true
MIN_MOVER_PCT=3
MAX_STOP_PCT=0.12
QUALITY_FILTERS=false
MIN_ALIGNED_FACTORS=1

SCAN_MODE=fast
MIN_TURNOVER_USDT=50000
SCAN_TOP_N=250
MAX_WORKERS=3
REQUEST_GAP_SECONDS=0.22
SCAN_INTERVAL_SECONDS=180
TELEGRAM_STATUS=false
LOG_LEVEL=INFO
