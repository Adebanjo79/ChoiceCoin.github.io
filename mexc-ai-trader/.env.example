# Copy to .env and fill in values
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=123456789

# Account balance used for 1% risk position sizing (USDT)
ACCOUNT_BALANCE_USDT=100

# Minimum confidence to emit a trade signal (0-100)
MIN_CONFIDENCE=80

# Full-market scans are heavy. 900 = 15 minutes between cycles.
SCAN_INTERVAL_SECONDS=900

# Keep this LOW for all-coins mode or MEXC returns code 510 (too frequent)
MAX_WORKERS=2

# Gap between each API call in seconds (0.35-0.50 recommended)
REQUEST_GAP_SECONDS=0.40

# Extra deals endpoint increases rate-limit risk; leave false for all-coins
FETCH_DEALS=false

# Leave empty to scan ALL MEXC USDT perpetual contracts
SYMBOL_WHITELIST=

LOG_LEVEL=INFO
