# Required: create a bot with @BotFather and paste the token here
BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token

# Default mint / contract address shown to users (Robinhood Chain is EVM: 0x...)
MINT_ADDRESS=0x0000000000000000000000000000000000000000

# Display name for the token
TOKEN_NAME=My Token

# Optional short ticker shown in messages
TOKEN_SYMBOL=TOKEN

# Comma-separated Telegram user IDs allowed to update the address
# Get your ID from @userinfobot
ADMIN_IDS=123456789

# Optional Blockscout / explorer base URL (no trailing slash)
EXPLORER_URL=https://robinhoodchain.blockscout.com
