# Optional — free token from https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# Optional — free key from https://the-odds-api.com (for bookmaker odds)
ODDS_API_KEY=

# Demo mode uses sample fixtures when APIs are unavailable (default: true if no football token)
DEMO_MODE=false

# Tip filters
MIN_CONFIDENCE=70
TARGET_ODDS=3.0
ODDS_TOLERANCE=0.75
MAX_DAILY_TIPS=5
MIN_DAILY_TIPS=1

# Leagues (comma-separated codes). Empty = all supported.
# PL=EPL, PD=La Liga, BL1=Bundesliga, FL1=Ligue 1, SA=Serie A,
# DED=Eredivisie, PPL=Primeira Liga, ELC=Championship, CL=UCL, BSA=Brasileirão
LEAGUES=PL,PD,BL1,FL1,SA,DED,PPL,ELC,CL

# Markets to consider: draw, away_win, home_win, btts_yes, over_25, under_25, over_35, away_or_draw
MARKETS=draw,away_win,over_25,btts_yes,away_or_draw,over_35

# Schedule
RUN_HOUR_UTC=8
SCAN_INTERVAL_HOURS=24
LOG_LEVEL=INFO

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
