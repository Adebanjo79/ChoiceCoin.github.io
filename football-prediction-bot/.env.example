# Optional — free token from https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# Optional — free key from https://the-odds-api.com (for bookmaker odds)
ODDS_API_KEY=

DEMO_MODE=false

# --- Odds bands ---
# Best ~3.0 (safety)
MIN_CONFIDENCE=70
SAFETY_MIN_CONFIDENCE=75
TARGET_ODDS=3.0
ODDS_TOLERANCE=0.75
MAX_DAILY_TIPS=3

# Best ~5.0 (value)
ODD5_MIN_CONFIDENCE=70
TARGET_ODDS_5=5.0
ODDS_TOLERANCE_5=1.25
MAX_TIPS_5=3

# Best ~50.0 (longshot / correct score)
ODD50_MIN_CONFIDENCE=60
TARGET_ODDS_50=50.0
ODDS_TOLERANCE_50=20
MAX_TIPS_50=3

INCLUDE_CORRECT_SCORES=true

# Accumulator sizes
# Safest ≈3.0 → 1, 2 or 3 games
ACCA3_MIN_LEGS=1
ACCA3_MAX_LEGS=3
# ≈5.0 → more than 3 games
ACCA5_MIN_LEGS=4
ACCA5_MAX_LEGS=6
# ≈50 → even more games
ACCA50_MIN_LEGS=7
ACCA50_MAX_LEGS=12
ACCA_LEG_ODDS_MIN=1.20
ACCA_LEG_ODDS_MAX=2.35

LEAGUES=PL,PD,BL1,FL1,SA,DED,PPL,ELC,CL
MARKETS=home_win,draw,away_win,over_25,under_25,btts_yes,btts_no,away_or_draw,home_or_draw,over_35,over_45,home_win_nil,away_win_nil

RUN_HOUR_UTC=8
SCAN_INTERVAL_HOURS=24
DAYS_AHEAD=30
STATUS_INTERVAL_HOURS=6
TELEGRAM_POLL_SECONDS=5
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
