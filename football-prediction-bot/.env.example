# Optional — free token from https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# Optional — free key from https://the-odds-api.com (for bookmaker odds)
ODDS_API_KEY=

# Demo mode uses sample fixtures when APIs are unavailable
DEMO_MODE=false

# Tip filters
MIN_CONFIDENCE=70
# Stricter gate used for Telegram "safety" daily tips
SAFETY_MIN_CONFIDENCE=75
TARGET_ODDS=3.0
ODDS_TOLERANCE=0.75
# Default 3 safety tips per day (~3.0 odds)
MAX_DAILY_TIPS=3
MIN_DAILY_TIPS=1

# Leagues (comma-separated codes). Empty = all supported.
# PL=EPL, PD=La Liga, BL1=Bundesliga, FL1=Ligue 1, SA=Serie A,
# DED=Eredivisie, PPL=Primeira Liga, ELC=Championship, CL=UCL, BSA=Brasileirão
LEAGUES=PL,PD,BL1,FL1,SA,DED,PPL,ELC,CL

# Markets to consider
MARKETS=draw,away_win,over_25,btts_yes,away_or_draw,over_35,home_or_draw

# Schedule
RUN_HOUR_UTC=8
SCAN_INTERVAL_HOURS=24
DAYS_AHEAD=30
# Push /status-style heartbeat to Telegram every N hours (0=off)
STATUS_INTERVAL_HOURS=6
TELEGRAM_POLL_SECONDS=5
LOG_LEVEL=INFO

# Telegram (required for alerts + /status /tips /safety commands)
# 1) Message @BotFather → /newbot → copy token
# 2) Start your bot, then get chat id (@userinfobot) → TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
