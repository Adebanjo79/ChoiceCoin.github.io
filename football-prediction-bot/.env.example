FOOTBALL_DATA_API_TOKEN=
ODDS_API_KEY=
DEMO_MODE=false

# Daily fixtures (today in TIMEZONE + next hours) — not multi-day
DAILY_ONLY=true
TIMEZONE=Africa/Lagos
DAILY_INCLUDE_NEXT_HOURS=24
# If today has 0 matches, load next fixtures within N days (off-season)
EMPTY_DAY_FALLBACK_DAYS=21
DAYS_AHEAD=1

MIN_CONFIDENCE=70
SAFETY_MIN_CONFIDENCE=75
TARGET_ODDS=3.0
ODDS_TOLERANCE=0.75
MAX_DAILY_TIPS=3

ODD5_MIN_CONFIDENCE=70
TARGET_ODDS_5=5.0
ODDS_TOLERANCE_5=1.25
MAX_TIPS_5=3

ODD50_MIN_CONFIDENCE=60
TARGET_ODDS_50=50.0
ODDS_TOLERANCE_50=20
MAX_TIPS_50=3

INCLUDE_CORRECT_SCORES=true

# Careful multi-match tickets
# ≈3.0 → exactly 3 matches, up to 3 options
ACCA3_MIN_LEGS=3
ACCA3_MAX_LEGS=3
ACCA3_OPTIONS=3
# ≈5.0 → 3–5 matches, up to 3 options
ACCA5_MIN_LEGS=3
ACCA5_MAX_LEGS=5
ACCA5_OPTIONS=3
# ≈50 → 5–15 matches
ACCA50_MIN_LEGS=5
ACCA50_MAX_LEGS=15
ACCA50_OPTIONS=2
ACCA_LEG_ODDS_MIN=1.20
ACCA_LEG_ODDS_MAX=2.35

LEAGUES=PL,PD,BL1,FL1,SA,DED,PPL,ELC,CL
MARKETS=home_win,draw,away_win,over_25,under_25,btts_yes,btts_no,away_or_draw,home_or_draw,over_35,over_45,home_win_nil,away_win_nil

RUN_HOUR_UTC=8
STATUS_INTERVAL_HOURS=6
TELEGRAM_POLL_SECONDS=5
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Real SportyBet.com booking / share codes (load in betslip)
SPORTYBET_ENABLED=true
SPORTYBET_COUNTRY=ng
