# Robinhood Chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5
EXPLORER_TX_URL=https://robinhoodchain.blockscout.com/tx/

# Comma-separated private keys for parallel minting wallets
PRIVATE_KEYS=

# OpenSea API key (required for mintSigned / signed_presale stages)
# Create at https://docs.opensea.io/reference/api-keys or use instant key endpoint
OPENSEA_API_KEY=
OPENSEA_API_BASE=https://api.opensea.io
OPENSEA_CHAIN=robinhood

# Optional Telegram alerts (same style as mint-activity notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Watcher
POLL_SECONDS=2
LOOKBACK_BLOCKS=8
DEFAULT_QUANTITY=0
# 0 = copy quantity from target mint (clamped to stage max)

# Safety
DRY_RUN=true
MAX_FEE_GWEI=5
MAX_PRIORITY_FEE_GWEI=1
CONFIRMATIONS=1