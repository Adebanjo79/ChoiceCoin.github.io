# Copy to .env and fill in keys for production API generation.
# Without keys the pipeline runs in DEMO mode (local synthetic clips + edge-tts).

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Adam (premade) — override if your workspace uses a different ID

# Prefer one video provider. Pika is tried first when both are set.
PIKA_API_KEY=
PIKA_API_BASE=https://api.pika.art/v1

RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1

# Force offline demo even if keys exist
DEMO_MODE=0

# Output
OUTPUT_DIR=output
MUSIC_DIR=music
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
FPS=30