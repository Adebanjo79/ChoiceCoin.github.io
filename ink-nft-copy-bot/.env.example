# Ink NFT copy-mint bot (Telegram)
# Defaults target Ink Chain (Kraken L2). Change RPC/CHAIN_ID only if you know what you are doing.

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Ink Chain
CHAIN_ID=57073
RPC_URL=https://rpc-gel.inkonchain.com
# Comma-separated backups (first in RPC_URL is primary; these are extras)
RPC_URLS=https://rpc-qnd.inkonchain.com
RPC_LOAD_BALANCE=false
RPC_RATE_LIMIT=25

EXPLORER_TX_URL=https://explorer.inkonchain.com/tx/
EXPLORER_ADDRESS_URL=https://explorer.inkonchain.com/address/
SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5

# Wallets to watch (comma-separated)
TARGET_WALLETS=

# Minting keys (comma-separated). Extra keys can be added via Telegram /addwallet → mint_wallets.json
PRIVATE_KEY=
PRIVATE_KEYS=

# Safety — start true; only flip after dry-run looks correct
DRY_RUN=true
FREE_MINTS_ONLY=true
PAUSED=false

POLL_INTERVAL_SEC=0.4
CATCHUP_CHUNK=40
GAS_LIMIT=350000
MAX_FEE_GWEI=5
MAX_PRIORITY_FEE_GWEI=1

# Optional mempool detection (faster, riskier — pending txs can revert and waste gas)
PENDING_DETECTION=false
PENDING_WS_URL=wss://rpc-gel.inkonchain.com

# Paths
MINT_WALLETS_FILE=mint_wallets.json
STATE_FILE=data/state.json